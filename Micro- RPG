# Micro RPG

from random import randint

npc_list = []


# Player
player = {
    "name": input("What is your hero's name? "),
    "level": 1,
    "exp": 0,
    "exp_max": 30,
    "hp": 100,
    "hp_max": 100,
    "damage": 25,
}


# Create NPCs
def create_npc(level):

    new_npc = {
        "name": "Armed Goblin",
        "level": level,
        "damage": 5 * level,
        "hp": 100 * level,
        "hp_max": 100 * level,
        "exp": 7 * level,
    }

    return new_npc


# Generate NPCs
def generate_npcs(n_npcs):
    for x in range(n_npcs):
        new_npc = create_npc(x + 1)
        npc_list.append(new_npc)


# Display NPCs
print()
def display_npcs():
    for npc in npc_list:
        display_npc(npc)

def display_npc(npc):
    print(f"{npc['name']} // Level: {npc['level']} // Damage: {npc['damage']} // HP: {npc['hp']}")
    print()

# Display Player
print()
def display_player():
    print(f"Name: {player['name']} // Level: {player['level']} // Damage: {player['damage']} // HP: {player['hp']}/{player['hp_max']} // EXP: {player['exp']}/{player['exp_max']}")
    print()

# Reset Player Attributes
def reset_player():
    player['hp'] = player['hp_max']

# Reset NPC Attributes
def reset_npc(npc):
    npc['hp'] = npc['hp_max']

# Level Up
def level_up():
    if player['exp'] >= player['exp_max']:
        player['level'] += 1
        player['exp'] = 0
        player['exp_max'] *= 2
        player['hp_max'] += 20
        player['damage'] += 25

# Start Battle
def start_battle(npc):
    while player['hp'] > 0 and npc['hp'] > 0:
        attack_npc(npc)
        attack_player(npc)
        battle_info(npc)

    if npc['hp'] == 0:  # player win
        print(f"{player['name']} won and gained {npc['exp']} EXP!")
        player['exp'] += npc['exp']
        display_player()

    else:  # npc win
        print(f"{npc['name']} won!")
        display_npc(npc)
    level_up()
    reset_player()
    reset_npc(npc)

# Attack NPC
def attack_npc(npc):
    npc["hp"] -= player["damage"]

# Attack Player
def attack_player(npc):
    player["hp"] -= npc["damage"]

# Battle Information
def battle_info(npc):
    print(f"{player['name']} Hp: {player['hp']}/{player['hp_max']}")
    print(f"{npc['name']}: {npc['hp']}/{npc['hp_max']}")
    print('------------------------\n')


generate_npcs(1)
display_npcs()


selected_npc = npc_list[0]
start_battle(selected_npc)
